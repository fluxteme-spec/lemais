# LêMais — variáveis de ambiente (copie para .env.local)
# Nenhuma é obrigatória. Sem elas, o app funciona e o teste automático
# de textos colados/importados aparece como indisponível.

# Opcional: IA do servidor (Anthropic), usada só quando o usuário não conectou a própria IA.
# Cada usuário pode conectar a sua em Configurações → Conectar minha IA.
ANTHROPIC_API_KEY=
# Modelo usado na geração (opcional)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Limites de uso por IP (requisições por janela de 10 minutos)
LEMAIS_EXTRACT_RATE_LIMIT=20
LEMAIS_QUESTIONS_RATE_LIMIT=10
