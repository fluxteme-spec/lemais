# LêMais — variáveis de ambiente (copie para .env.local para testar no computador,
# ou cadastre na Vercel em Settings → Environment Variables).

# ---- Contas (Supabase) ----
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRETA: só no servidor. Nunca compartilhe nem coloque em código.
SUPABASE_SECRET_KEY=sb_secret_...

# E-mails com acesso ao painel do desenvolvedor (separados por vírgula)
ADMIN_EMAILS=seu-email@gmail.com

# Endereço público do app (usado nos cartões de compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dados exibidos na Política de privacidade e nos Termos
NEXT_PUBLIC_RESPONSAVEL=Seu nome ou empresa (CNPJ)
NEXT_PUBLIC_CONTATO=contato@seudominio.com.br

# ---- Opcional ----
# IA do servidor (Anthropic), usada só quando o usuário não conectou a própria IA.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LEMAIS_EXTRACT_RATE_LIMIT=20
LEMAIS_QUESTIONS_RATE_LIMIT=10

# Mostrar o botão "Continuar com Google" (só depois de ativar o Google no Supabase)
# NEXT_PUBLIC_GOOGLE_LOGIN=1
